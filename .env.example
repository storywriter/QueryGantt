EXTENSION_DESCRIPTION="YOUR_EXTENSION_DESCRIPTION"
EXTENSION_PUBLIC=false
EXTENSION_SUPPORT_URI=
EXTENSION_REPOSITORY_URI=YOUR_REPOSITORY_URL
EXTENSION_FEATURE_NAME="YOUR_FEATURE_NAME"
EXTENSION_TAB_TITLE="YOUR_TAB_TITLE"
EXTENSION_TAB_NAME="YOUR_TAB_NAME"
EXTENSION_OVERVIEW_NOTICE=""
EXTENSION_OVERVIEW_SUPPORT_TEXT=""
